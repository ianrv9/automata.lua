/* Made by matugen from your wallpaper. Gets overwritten. */
* {
    accent:      {{colors.primary.default.hex}};
    accent2:     {{colors.tertiary.default.hex}};
    onAccent: {{colors.on_primary.default.hex}};
    bg:       {{colors.surface.default.hex_alpha | set_alpha: 0.88}};
    surface:  {{colors.surface_container_high.default.hex_alpha | set_alpha: 0.7}};
    text:       {{colors.on_surface.default.hex}};
    dim:       {{colors.on_surface_variant.default.hex}};
    border:       {{colors.outline_variant.default.hex}};
    error:       {{colors.error.default.hex}};
}
