#!/bin/bash
# Power menu. Asks before shutting down or rebooting, because we've all misclicked.
theme="$HOME/.config/rofi/menu.rasi"
options=$'  @@t:lock@@\n  @@t:suspend@@\n  @@t:logout@@\n  @@t:reboot@@\n  @@t:poweroff@@'
choice=$(printf '%s' "$options" | rofi -dmenu -i -p "@@t:power@@" -theme "$theme")

sure() {
    local yes=$''"  @@t:yes@@ ${1,,}" no=$'  @@t:cancel@@'
    [ "$(printf '%s\n%s' "$yes" "$no" | rofi -dmenu -i -p "@@t:sure@@" -theme "$theme")" = "$yes" ]
}

case "$choice" in
    *"@@t:lock@@")     loginctl lock-session ;;
    *"@@t:suspend@@")  systemctl suspend ;;
    *"@@t:logout@@")   sure "@@t:logout@@" && { command -v hyprshutdown >/dev/null && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'; } ;;
    *"@@t:reboot@@")   sure "@@t:reboot@@" && systemctl reboot ;;
    *"@@t:poweroff@@") sure "@@t:poweroff@@" && systemctl poweroff ;;
esac
